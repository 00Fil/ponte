<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fondo e barre di sistema seguono bg-canvas di Canone (chiaro #F4F4F2, scuro #0E0E0F). -->
    <style name="Theme.Ponte" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>
    <style name="Theme.Ponte.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
