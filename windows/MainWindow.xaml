<Window
    x:Class="Ponte.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="Ponte">

    <Grid x:Name="Root" Background="{ThemeResource BgCanvas}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SideCol" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra laterale, dalle finestre estese (1024) in su. -->
        <StackPanel x:Name="Side" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Padding="16" Spacing="4">
            <TextBlock Text="Ponte" Style="{StaticResource Title3}" Margin="12,16,12,24" />
            <StackPanel x:Name="SideTabs" Spacing="4" />
        </StackPanel>

        <!-- Le cinque pagine: una alla volta, ricostruite dal codice. -->
        <Grid Grid.Row="0" Grid.Column="1">
            <ScrollViewer x:Name="Page0"><StackPanel x:Name="Host0" MaxWidth="720" Margin="24,24,24,48" Spacing="16" HorizontalAlignment="Stretch" /></ScrollViewer>
            <ScrollViewer x:Name="Page1" Visibility="Collapsed"><StackPanel x:Name="Host1" MaxWidth="720" Margin="24,24,24,48" Spacing="16" HorizontalAlignment="Stretch" /></ScrollViewer>
            <ScrollViewer x:Name="Page2" Visibility="Collapsed"><StackPanel x:Name="Host2" MaxWidth="1024" Margin="24,24,24,48" Spacing="16" HorizontalAlignment="Stretch" /></ScrollViewer>
            <ScrollViewer x:Name="Page3" Visibility="Collapsed"><StackPanel x:Name="Host3" MaxWidth="720" Margin="24,24,24,48" Spacing="16" HorizontalAlignment="Stretch" /></ScrollViewer>
            <ScrollViewer x:Name="Page4" Visibility="Collapsed"><StackPanel x:Name="Host4" MaxWidth="720" Margin="24,24,24,48" Spacing="16" HorizontalAlignment="Stretch" /></ScrollViewer>
        </Grid>

        <!-- Barra in basso, sotto i 1024. -->
        <Border x:Name="Bottom" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource BarStyle}" Visibility="Collapsed">
            <Grid x:Name="BottomTabs" ColumnSpacing="4" />
        </Border>

        <tb:TaskbarIcon x:Name="Tray" ToolTipText="Ponte" IconSource="ms-appx:///Assets/ponte.ico" NoLeftClickDelay="True">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Apri Ponte" Click="OnTrayOpen" />
                    <MenuFlyoutItem Text="Esci" Click="OnTrayExit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
