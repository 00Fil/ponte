    <!-- Il blu di Relay anche nei controlli di sistema (selettori di data, menu, finestre di dialogo). -->
    <Color x:Key="SystemAccentColor">#2F5FFF</Color>
    <Color x:Key="SystemAccentColorLight1">#5C9DFF</Color>
    <Color x:Key="SystemAccentColorLight2">#B4D2FF</Color>
    <Color x:Key="SystemAccentColorLight3">#EAF1FF</Color>
    <Color x:Key="SystemAccentColorDark1">#1F44CC</Color>
    <Color x:Key="SystemAccentColorDark2">#1F44CC</Color>
    <Color x:Key="SystemAccentColorDark3">#11244F</Color>
    <CornerRadius x:Key="ControlCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">20</CornerRadius>
    <Thickness x:Key="TextControlBorderThemeThickness">1.5</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1.5</Thickness>

    <!-- Il gradiente di Relay: cielo, blu, oltremare, dall'alto in basso. -->
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#5C9DFF" Offset="0" />
        <GradientStop Color="#1F44CC" Offset="0.5" />
        <GradientStop Color="#11244F" Offset="1" />
    </LinearGradientBrush>

    <!-- Geist e Geist Mono, con ripiego sul font di sistema. -->
    <FontFamily x:Key="FontSans">ms-appx:///Assets/Fonts/Geist-Regular.ttf#Geist, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontSansMedium">ms-appx:///Assets/Fonts/Geist-Medium.ttf#Geist Medium, ms-appx:///Assets/Fonts/Geist-Medium.ttf#Geist, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">ms-appx:///Assets/Fonts/GeistMono-Regular.ttf#Geist Mono, Cascadia Mono, Consolas</FontFamily>

    <!-- Testo: la scala di Android (13, 16, 20, 25, 31, 39). -->
    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSansMedium}" />
        <Setter Property="FontSize" Value="39" />
        <Setter Property="LineHeight" Value="44" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="Title1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSansMedium}" />
        <Setter Property="FontSize" Value="39" />
        <Setter Property="LineHeight" Value="44" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="Title2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSansMedium}" />
        <Setter Property="FontSize" Value="31" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="Title3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSansMedium}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSansMedium}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="Callout" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="BodyMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSansMedium}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="Footnote" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="CharacterSpacing" Value="10" />
        <Setter Property="Foreground" Value="{ThemeResource LabelSecondary}" />
    </Style>
    <Style x:Key="FootnoteTertiary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="CharacterSpacing" Value="10" />
        <Setter Property="Foreground" Value="{ThemeResource LabelTertiary}" />
    </Style>
    <Style x:Key="Figure" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>

    <!-- Superfici: piane, raggio 28, senza bordo. Il vetro resta ai tasti e alle bolle. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BgSurface}" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="ThumbStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BgSunken}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Height" Value="112" />
    </Style>
    <Style x:Key="DividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource LineSeparator}" />
    </Style>

    <!-- Riquadro premibile (archivio): piano, raggio 20; si abbassa quando lo premi. -->
    <ControlTemplate x:Key="TileTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="Scale" /></Grid.RenderTransform>
            <Border x:Name="Face" CornerRadius="20" Background="{ThemeResource BgSurface}" />
            <Border x:Name="Veil" CornerRadius="20" Background="{ThemeResource LabelPrimary}" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition From="Pressed" To="Normal"><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.96" /><EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="1.014"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="0.995"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.96" /><EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="1.014"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="0.995"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames></Storyboard></VisualTransition>
                    <VisualTransition From="Pressed" To="PointerOver"><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.96" /><EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="1.014"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="0.995"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.96" /><EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="1.014"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="0.995"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames></Storyboard></VisualTransition>
                </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal"><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" /></Storyboard></VisualState>
                    <VisualState x:Name="PointerOver"><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.04" Duration="0:0:0.12" /></Storyboard></VisualState>
                    <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.08" /><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.1" /><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.1" /></Storyboard></VisualState>
                    <VisualState x:Name="Disabled"></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>
    <Style x:Key="TileStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource TileTemplate}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="ViewerRound" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Disc" Fill="#FFFFFF" Opacity="0.14" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"><Storyboard><DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.15" /></Storyboard></VisualState>
                                <VisualState x:Name="PointerOver"><Storyboard><DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="Opacity" To="0.26" Duration="0:0:0.15" /></Storyboard></VisualState>
                                <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0:0:0.08" /></Storyboard></VisualState>
                                <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.1" /></Storyboard></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pulsanti (CButton): pillola alta 44. Premendo si deforma solo il contenitore, la scritta resta ferma. -->
    <ControlTemplate x:Key="PillButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" MinHeight="44" Background="Transparent">
            <Border x:Name="Face" Height="44" CornerRadius="22" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Border.RenderTransform><ScaleTransform x:Name="Scale" /></Border.RenderTransform>
                <Border x:Name="Veil" CornerRadius="22" Opacity="0" IsHitTestVisible="False" Background="{TemplateBinding Foreground}" />
            </Border>
            <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition From="Pressed" To="Normal"><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="1.06" /><EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="0.979"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1.007"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="1.08" /><EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="0.972"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1.01"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames></Storyboard></VisualTransition>
                    <VisualTransition From="Pressed" To="PointerOver"><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="1.06" /><EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="0.979"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1.007"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"><LinearDoubleKeyFrame KeyTime="0:0:0" Value="1.08" /><EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="0.972"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1.01"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames></Storyboard></VisualTransition>
                </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal"><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" /></Storyboard></VisualState>
                    <VisualState x:Name="PointerOver"><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0:0:0.12" /></Storyboard></VisualState>
                    <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.08" /><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.1" /><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.1" /></Storyboard></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PillButtonTemplate}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSansMedium}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{StaticResource BrandGradient}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#24FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{ThemeResource DropFill}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DropEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="TertiaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AccentDefault}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{ThemeResource CriticalGradient}" />
        <Setter Property="Foreground" Value="{ThemeResource CriticalOnCritical}" />
    </Style>
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{ThemeResource BgSunken}" />
        <Setter Property="Foreground" Value="{ThemeResource LabelSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style x:Key="ChipButtonSelected" TargetType="Button" BasedOn="{StaticResource ChipButton}">
        <Setter Property="Background" Value="{ThemeResource AccentDefault}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Barra laterale (SideItem): pillola alta 44; la voce scelta ha il fondo azzurro. -->
    <ControlTemplate x:Key="NavItemTemplate" TargetType="Button">
        <Grid Height="44" Background="Transparent">
            <Border CornerRadius="22" Background="{TemplateBinding Background}" />
            <Border x:Name="Veil" CornerRadius="22" Opacity="0" IsHitTestVisible="False" Background="{TemplateBinding Foreground}" />
            <ContentPresenter Content="{TemplateBinding Content}" Padding="16,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" Foreground="{TemplateBinding Foreground}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" /></Storyboard></VisualState>
                    <VisualState x:Name="PointerOver"><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.12" /></Storyboard></VisualState>
                    <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0:0:0.06" /></Storyboard></VisualState>
                    <VisualState x:Name="Disabled" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>
    <Style x:Key="NavItem" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource NavItemTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource LabelSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="NavItemSelected" TargetType="Button" BasedOn="{StaticResource NavItem}">
        <Setter Property="Background" Value="{ThemeResource AccentSubtle}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentOnSubtle}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSansMedium}" />
    </Style>

    <!-- Bottone nudo: solo il contenuto, per tasti disegnati in codice (bolle, interruttori, riquadri). -->
    <Style x:Key="BareButton" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter Background="Transparent" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BareToggle" TargetType="ToggleButton">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <ContentPresenter Background="Transparent" Content="{TemplateBinding Content}" CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campi (CField): alti 44, raggio 14, piani. L'etichetta sta sopra, in un TextBlock a parte. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,10,10,10" />
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,10,10,10" />
    </Style>
</ResourceDictionary>
