<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Canone: ruoli di colore. Stessi nomi nei due temi, valori propri. Nessun esadecimale fuori da questo file. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BgCanvas" Color="#F4F4F2" />
            <SolidColorBrush x:Key="BgSurface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BgSunken" Color="#EDEDEA" />
            <SolidColorBrush x:Key="BgInverse" Color="#121212" />
            <SolidColorBrush x:Key="LabelPrimary" Color="#121212" />
            <SolidColorBrush x:Key="LabelSecondary" Color="#4A4A47" />
            <SolidColorBrush x:Key="LabelTertiary" Color="#6B6B66" />
            <SolidColorBrush x:Key="LabelDisabled" Color="#85857F" />
            <SolidColorBrush x:Key="LabelInverse" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LineSeparator" Color="#E2E2DE" />
            <SolidColorBrush x:Key="LineStrong" Color="#CACAC5" />
            <SolidColorBrush x:Key="FillControl" Color="#CACAC5" />
            <SolidColorBrush x:Key="FillSelected" Color="#121212" />
            <SolidColorBrush x:Key="AccentDefault" Color="#2453D6" />
            <SolidColorBrush x:Key="AccentSubtle" Color="#E8EEFC" />
            <SolidColorBrush x:Key="AccentOnSubtle" Color="#1B3FA8" />
            <SolidColorBrush x:Key="PositiveSubtle" Color="#E5F2EA" />
            <SolidColorBrush x:Key="PositiveOnSubtle" Color="#17603C" />
            <SolidColorBrush x:Key="CautionSubtle" Color="#FBF0E0" />
            <SolidColorBrush x:Key="CautionOnSubtle" Color="#7F4600" />
            <SolidColorBrush x:Key="CriticalDefault" Color="#C3262B" />
            <SolidColorBrush x:Key="CriticalSubtle" Color="#FBEAEA" />
            <SolidColorBrush x:Key="CriticalOnSubtle" Color="#A11F24" />
            <SolidColorBrush x:Key="CriticalOnCritical" Color="#FFFFFF" />
            <!-- Interruttori: acceso = fill-selected, spento = fill-control, pomello = bg-surface. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#121212" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#121212" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#121212" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#CACAC5" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#CACAC5" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#CACAC5" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#121212" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#121212" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#121212" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#CACAC5" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#CACAC5" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#CACAC5" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogForeground" Color="#121212" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#E2E2DE" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BgCanvas" Color="#0E0E0F" />
            <SolidColorBrush x:Key="BgSurface" Color="#1A1A1B" />
            <SolidColorBrush x:Key="BgSunken" Color="#242426" />
            <SolidColorBrush x:Key="BgInverse" Color="#F2F2F0" />
            <SolidColorBrush x:Key="LabelPrimary" Color="#F2F2F0" />
            <SolidColorBrush x:Key="LabelSecondary" Color="#A6A6A1" />
            <SolidColorBrush x:Key="LabelTertiary" Color="#85857F" />
            <SolidColorBrush x:Key="LabelDisabled" Color="#6B6B66" />
            <SolidColorBrush x:Key="LabelInverse" Color="#121212" />
            <SolidColorBrush x:Key="LineSeparator" Color="#2E2E30" />
            <SolidColorBrush x:Key="LineStrong" Color="#3A3A3C" />
            <SolidColorBrush x:Key="FillControl" Color="#3A3A3C" />
            <SolidColorBrush x:Key="FillSelected" Color="#F2F2F0" />
            <SolidColorBrush x:Key="AccentDefault" Color="#7A9BFF" />
            <SolidColorBrush x:Key="AccentSubtle" Color="#1C2647" />
            <SolidColorBrush x:Key="AccentOnSubtle" Color="#A3B8FF" />
            <SolidColorBrush x:Key="PositiveSubtle" Color="#12301F" />
            <SolidColorBrush x:Key="PositiveOnSubtle" Color="#4CC38A" />
            <SolidColorBrush x:Key="CautionSubtle" Color="#3A2508" />
            <SolidColorBrush x:Key="CautionOnSubtle" Color="#F0A54A" />
            <SolidColorBrush x:Key="CriticalDefault" Color="#FF7A73" />
            <SolidColorBrush x:Key="CriticalSubtle" Color="#3D1517" />
            <SolidColorBrush x:Key="CriticalOnSubtle" Color="#FF7A73" />
            <SolidColorBrush x:Key="CriticalOnCritical" Color="#0E0E0F" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#F2F2F0" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#F2F2F0" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#F2F2F0" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#3A3A3C" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#3A3A3C" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#3A3A3C" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#F2F2F0" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#F2F2F0" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#F2F2F0" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#3A3A3C" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#3A3A3C" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#3A3A3C" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#1A1A1B" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#1A1A1B" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#1A1A1B" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#F2F2F0" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#F2F2F0" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#F2F2F0" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#1A1A1B" />
            <SolidColorBrush x:Key="ContentDialogForeground" Color="#F2F2F0" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#2E2E30" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Geist e Geist Mono, con ripiego sul font di sistema. -->
    <FontFamily x:Key="FontSans">ms-appx:///Assets/Fonts/Geist-Regular.ttf#Geist, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontSansMedium">ms-appx:///Assets/Fonts/Geist-Medium.ttf#Geist Medium, ms-appx:///Assets/Fonts/Geist-Medium.ttf#Geist, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">ms-appx:///Assets/Fonts/GeistMono-Regular.ttf#Geist Mono, Cascadia Mono, Consolas</FontFamily>

    <!-- Testo: scala 1,25 (13, 16, 20, 25, 31, 39) con interlinea sulla griglia di 4. -->
    <Style x:Key="Title1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSansMedium}" />
        <Setter Property="FontSize" Value="39" />
        <Setter Property="LineHeight" Value="44" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="Title3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSansMedium}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="Footnote" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="CharacterSpacing" Value="10" />
        <Setter Property="Foreground" Value="{ThemeResource LabelSecondary}" />
    </Style>
    <Style x:Key="FootnoteTertiary" TargetType="TextBlock" BasedOn="{StaticResource Footnote}">
        <Setter Property="Foreground" Value="{ThemeResource LabelTertiary}" />
    </Style>
    <Style x:Key="Figure" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock" BasedOn="{StaticResource Footnote}" />
    <Style x:Key="BadgeTextPositive" TargetType="TextBlock" BasedOn="{StaticResource Footnote}">
        <Setter Property="Foreground" Value="{ThemeResource PositiveOnSubtle}" />
    </Style>
    <Style x:Key="BadgeTextCaution" TargetType="TextBlock" BasedOn="{StaticResource Footnote}">
        <Setter Property="Foreground" Value="{ThemeResource CautionOnSubtle}" />
    </Style>
    <Style x:Key="BadgeTextCritical" TargetType="TextBlock" BasedOn="{StaticResource Footnote}">
        <Setter Property="Foreground" Value="{ThemeResource CriticalOnSubtle}" />
    </Style>
    <Style x:Key="BadgeTextAccent" TargetType="TextBlock" BasedOn="{StaticResource Footnote}">
        <Setter Property="Foreground" Value="{ThemeResource AccentOnSubtle}" />
    </Style>

    <!-- Superfici. Card: raggio 28, margine 24, filetto a riposo. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BgSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="TileStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource BgSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- Anteprima dentro una scheda: raggio interno = 20 - margine 8 = 12. -->
    <Style x:Key="ThumbStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BgSunken}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Height" Value="120" />
    </Style>
    <Style x:Key="BarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BgSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineSeparator}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style x:Key="DividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource LineSeparator}" />
    </Style>
    <Style x:Key="BadgeNeutral" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BgSunken}" />
        <Setter Property="CornerRadius" Value="9999" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgePositive" TargetType="Border" BasedOn="{StaticResource BadgeNeutral}">
        <Setter Property="Background" Value="{ThemeResource PositiveSubtle}" />
    </Style>
    <Style x:Key="BadgeCaution" TargetType="Border" BasedOn="{StaticResource BadgeNeutral}">
        <Setter Property="Background" Value="{ThemeResource CautionSubtle}" />
    </Style>
    <Style x:Key="BadgeCritical" TargetType="Border" BasedOn="{StaticResource BadgeNeutral}">
        <Setter Property="Background" Value="{ThemeResource CriticalSubtle}" />
    </Style>
    <Style x:Key="BadgeAccent" TargetType="Border" BasedOn="{StaticResource BadgeNeutral}">
        <Setter Property="Background" Value="{ThemeResource AccentSubtle}" />
    </Style>

    <!-- Pulsanti: sempre tondi, alti 44 con area di 48, velo al 6 % in hover e al 12 % da premuti, 40 % se disattivati. -->
    <ControlTemplate x:Key="PillButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" MinHeight="48" Background="Transparent">
            <Border x:Name="Pill" Height="44" CornerRadius="22" Background="{TemplateBinding Background}">
                <Grid>
                    <Border x:Name="Veil" CornerRadius="22" Opacity="0" IsHitTestVisible="False"
                            Background="{TemplateBinding Foreground}" />
                    <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Padding="24,0"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters><Setter Target="Veil.Opacity" Value="0.06" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters><Setter Target="Veil.Opacity" Value="0.12" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters><Setter Target="Pill.Opacity" Value="0.4" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PillButtonTemplate}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSansMedium}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{ThemeResource BgInverse}" />
        <Setter Property="Foreground" Value="{ThemeResource LabelInverse}" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{ThemeResource BgSunken}" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{ThemeResource CriticalDefault}" />
        <Setter Property="Foreground" Value="{ThemeResource CriticalOnCritical}" />
    </Style>
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{ThemeResource BgSunken}" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="ChipButtonSelected" TargetType="Button" BasedOn="{StaticResource ChipButton}">
        <Setter Property="Background" Value="{ThemeResource AccentSubtle}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentOnSubtle}" />
    </Style>

    <!-- Voci della barra di navigazione. -->
    <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource LabelSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="TabButtonSelected" TargetType="Button" BasedOn="{StaticResource TabButton}">
        <Setter Property="Background" Value="{ThemeResource BgSunken}" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSansMedium}" />
    </Style>

    <!-- Campi: raggio 14, altezza 44, bordo 1,5. L'etichetta sta sopra, in un TextBlock a parte. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="16,9,16,9" />
        <Setter Property="Background" Value="{ThemeResource BgSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineStrong}" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="16,9,16,9" />
        <Setter Property="Background" Value="{ThemeResource BgSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineStrong}" />
        <Setter Property="Foreground" Value="{ThemeResource LabelPrimary}" />
    </Style>
</ResourceDictionary>
